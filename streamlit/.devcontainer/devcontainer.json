{
	"name": "Streamlit App",
	"dockerComposeFile": [
		"../compose.yml"
	],
	"service": "dev",
	"workspaceFolder": "/usr/src/app",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
